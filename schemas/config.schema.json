{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crucible User or Repository Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "$ref": "#/$defs/profileSettings"
    },
    "profiles": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": ["match"],
            "properties": {
              "match": {
                "type": "string",
                "description": "Path glob matched against the resolved repository path (supports ~, *, **)."
              }
            }
          },
          { "$ref": "#/$defs/profileSettings" }
        ]
      }
    },
    "council": { "$ref": "#/$defs/council" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "pr": { "$ref": "#/$defs/pr" },
    "verify": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hooks": { "$ref": "#/$defs/hooks" }
  },
  "$defs": {
    "council": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "model"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "provider": { "type": "string" },
              "model": { "type": "string" },
              "options": { "type": "object" },
              "minScore": {
                "type": "number",
                "minimum": 1,
                "maximum": 10,
                "description": "Optional per-member passing score threshold overriding council.minScore."
              },
              "calibration": {
                "type": "string",
                "description": "Optional per-member review instructions appended to this member's council prompt."
              }
            }
          }
        },
        "minScore": { "type": "number", "minimum": 1, "maximum": 10 },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "heavyMaxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Round cap for UI-heavy or large changes, applied by `crucible sign --heavy`."
        },
        "passRule": {
          "enum": ["convergence", "scores"],
          "description": "convergence: 0 blockers, 0 accepted majors outside the latest fix hunks, median score >= minScore (waived while fix-hunk majors await a follow-up). scores: 0 blockers and every member >= its minScore."
        },
        "hotspotRounds": {
          "type": "integer",
          "minimum": 2,
          "description": "Consecutive failing rounds with accepted findings in the same area before a recorded redesign is required."
        },
        "renderCheck": {
          "enum": ["always", "auto", "never"],
          "description": "Drive the app at desktop, phone, and 320px viewports before each council round (auto: only when the diff touches UI)."
        },
        "specCouncil": { "enum": ["always", "auto", "never"] }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "councilRounds": { "type": "integer", "minimum": 1 },
        "ciFixPushes": { "type": "integer", "minimum": 0 },
        "prWatchPushes": { "type": "integer", "minimum": 0 }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "markReadyOnGreen": { "type": "boolean" },
        "autoMergeCleanBase": { "type": "boolean" },
        "resolveHumanThreads": { "type": "boolean" },
        "language": { "type": "string" },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "neverMerge": { "const": true },
        "neverForcePush": { "const": true }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postWorktreeSetup": { "type": "string" },
        "prePrOpen": { "type": "string" },
        "postPrOpen": { "type": "string" },
        "workflowSkill": { "type": "string" },
        "prePrOpenSkill": { "type": "string" },
        "commentVoiceSkill": { "type": "string" }
      }
    },
    "profileSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "council": { "$ref": "#/$defs/council" },
        "budgets": { "$ref": "#/$defs/budgets" },
        "pr": { "$ref": "#/$defs/pr" },
        "verify": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hooks": { "$ref": "#/$defs/hooks" }
      }
    }
  }
}
